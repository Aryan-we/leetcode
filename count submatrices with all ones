class Solution:
    def numSubmat(self, mat):
        m, n = len(mat), len(mat[0])
        res = 0

        for i in range(m):
            for j in range(n):
                if mat[i][j] == 1:
                    if j == 0:
                        mat[i][j] = 1
                    else:
                        mat[i][j] = mat[i][j - 1] + 1

        for i in range(m):
            for j in range(n):
                if mat[i][j] == 0:
                    continue
                min_width = mat[i][j]
                for k in range(i, -1, -1):
                    if mat[k][j] == 0:
                        break
                    min_width = min(min_width, mat[k][j])
                    res += min_width

        return res
